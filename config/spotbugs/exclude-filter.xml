<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring DI constructor-injected fields are singleton beans managed by the container -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2,EI2"/>
        <Or>
            <Class name="~.*Controller"/>
            <Class name="~.*Service"/>
            <Class name="~.*Config"/>
            <Class name="~.*ScheduledTokenCleanup"/>
        </Or>
    </Match>

    <!-- JPA entity lifecycle callbacks -->
    <Match>
        <Method name="~on(Create|Update)"/>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>
</FindBugsFilter>
