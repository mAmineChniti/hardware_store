@startuml Schéma Base de Données - Magasin de Matériaux
' INOVEXAHUB - Système de Gestion Commerciale et Point de Vente (POS)
' Sprint 1: Modélisation UML - Schéma Base de Données
' Version: 2.0 (LotsProduit, VarianteProduit, FraisLivraison)
' Base de données: PostgreSQL

skinparam linetype ortho
skinparam entity {
  BackgroundColor<<FK>> LightBlue
  BorderColor<<FK>> Blue
}

' ============================================
' TABLES
' ============================================

entity utilisateurs {
  id BIGSERIAL PK
  prénom VARCHAR(50)
  nom VARCHAR(50)
  email VARCHAR(100) UNIQUE CHECK (email = LOWER(email))
  mot_de_passe VARCHAR
  rôle VARCHAR(20)
  activé BOOLEAN
  date_création TIMESTAMP
  date_modification TIMESTAMP
}

entity clients {
  id BIGSERIAL PK
  version BIGINT
  nom VARCHAR(100)
  téléphone VARCHAR(20)
  email VARCHAR(100)
  adresse VARCHAR(255)
  numéro_matricule_fiscal VARCHAR(50)
  limite_crédit DECIMAL(19,3)
  dette_actuelle DECIMAL(19,3)
  supprimé BOOLEAN
  date_création TIMESTAMP
  date_modification TIMESTAMP
}

entity fournisseurs {
  id BIGSERIAL PK
  nom VARCHAR(100)
  téléphone VARCHAR(20)
  email VARCHAR(100)
  adresse VARCHAR(255)
  numéro_matricule_fiscal VARCHAR(50)
  personne_contact VARCHAR(100)
  conditions_paiement VARCHAR(100)
  notes VARCHAR(500)
  supprimé BOOLEAN
  date_création TIMESTAMP
  date_modification TIMESTAMP
}

entity produits {
  id BIGSERIAL PK
  version BIGINT
  référence VARCHAR(50) UNIQUE
  nom VARCHAR(100)
  description VARCHAR(500)
  image TEXT
  catégorie VARCHAR(50)
  type_unité VARCHAR(20)
  unité_base VARCHAR(20)
  quantité_stock DECIMAL(19,3)
  prix_moyen_achat DECIMAL(19,3)
  prix_unitaire DECIMAL(19,3)
  fournisseur_id BIGINT FK
  date_création TIMESTAMP
  date_modification TIMESTAMP
}

entity variantes_produits {
  id BIGSERIAL PK
  version BIGINT
  produit_id BIGINT FK
  sku VARCHAR(50) UNIQUE
  nom_variante VARCHAR(100)
  attributs TEXT
  date_création TIMESTAMP
  date_modification TIMESTAMP
}

entity conditionnements_produits {
  id BIGSERIAL PK
  produit_id BIGINT FK
  description VARCHAR(100)
  quantité_par_unité DECIMAL(19,3)
  prix_unitaire DECIMAL(19,3)
  date_création TIMESTAMP
  date_modification TIMESTAMP
}

entity lots_produits {
  id BIGSERIAL PK
  version BIGINT
  produit_id BIGINT FK
  variante_id BIGINT FK
  quantité DECIMAL(19,3)
  coût_unitaire DECIMAL(19,3)
  prix_unitaire DECIMAL(19,3)
  fournisseur_id BIGINT FK
  notes VARCHAR(500)
  date_création TIMESTAMP
  date_modification TIMESTAMP
}

entity documents {
  id BIGSERIAL PK
  version BIGINT
  numéro_document VARCHAR(50) UNIQUE
  date TIMESTAMP
  type_document VARCHAR(20)
  statut VARCHAR(20)
  client_id BIGINT FK
  utilisateur_id BIGINT FK
  total_hors_taxe DECIMAL(19,3)
  taux_tva DECIMAL(5,2)
  total_tva DECIMAL(19,3)
  total_ttc DECIMAL(19,3)
  est_livraison BOOLEAN
  frais_transport DECIMAL(19,3)
  droit_timbre DECIMAL(19,3)
  est_vente_crédit BOOLEAN
  converti_en_facture_id BIGINT
  source_bon_livraison_id BIGINT
  date_création TIMESTAMP
  date_modification TIMESTAMP
}

entity lignes_documents {
  id BIGSERIAL PK
  document_id BIGINT FK
  produit_id BIGINT FK
  variante_id BIGINT FK
  numéro_ligne INTEGER
  description_conditionnement VARCHAR(100)
  quantité_par_unité_conditionnement DECIMAL(19,3)
  allocations_lots TEXT
  quantité DECIMAL(19,3)
  prix_unitaire DECIMAL(19,3)
  coût_unitaire DECIMAL(19,3)
  total_ligne_hors_taxe DECIMAL(19,3)
  total_ligne_ttc DECIMAL(19,3)
  est_livré BOOLEAN
  date_création TIMESTAMP
  date_modification TIMESTAMP
}

entity reçus_paiements {
  id BIGSERIAL PK
  numéro_reçu VARCHAR(50) UNIQUE
  client_id BIGINT FK
  utilisateur_id BIGINT FK
  montant_payé DECIMAL(19,3)
  date_paiement TIMESTAMP
  mode_paiement VARCHAR(20)
  dette_précédente DECIMAL(19,3)
  nouvelle_dette DECIMAL(19,3)
  historique_crédit_id BIGINT FK
  date_création TIMESTAMP
  date_modification TIMESTAMP
}

entity historique_crédit {
  id BIGSERIAL PK
  client_id BIGINT FK
  document_id BIGINT FK
  reçu_paiement_id BIGINT FK
  type_transaction VARCHAR(20)
  montant DECIMAL(19,3)
  solde_courant DECIMAL(19,3)
  supprimé BOOLEAN
  date_entrée TIMESTAMP
}

entity journal_audit {
  id BIGSERIAL PK
  utilisateur_id BIGINT /* instantané d'identité facultatif, sans FK */
  email VARCHAR(100)
  action VARCHAR(100)
  type_entité VARCHAR(50)
  id_entité BIGINT
  détails TEXT
  horodatage TIMESTAMP
}

note right of journal_audit
  utilisateur_id: instantané d'identité FACULTATIF (nullable, sans FK)
  email: instantané de l'email de l'utilisateur au moment de l'action
  Une entrée d'audit peut n'avoir aucun utilisateur ou survivre à un utilisateur supprimé
end note

entity jetons_rafraîchissement {
  id BIGSERIAL PK
  hash_jeton VARCHAR(64) UNIQUE
  utilisateur_id BIGINT FK
  date_expiration TIMESTAMP
  révoqué BOOLEAN
  date_création TIMESTAMP
}

entity jetons_accès {
  id BIGSERIAL PK
  hash_jeton VARCHAR(64) UNIQUE
  utilisateur_id BIGINT FK
  date_expiration TIMESTAMP
  révoqué BOOLEAN
  date_création TIMESTAMP
}

entity jetons_réinitialisation {
  id BIGSERIAL PK
  utilisateur_id BIGINT FK
  email VARCHAR(100) INDEX
  code_otp_hash VARCHAR(100) /* BCrypt hashé */
  date_expiration TIMESTAMP
  utilisé BOOLEAN
  tentatives_échouées INTEGER
  date_création TIMESTAMP
}

note bottom of jetons_réinitialisation
  Index partiel unique idx_prt_active_user:
  au plus un jeton actif (non utilisé) par utilisateur
  code_otp_hash: stocké en hash BCrypt, jamais en clair
end note

' ============================================
' RELATIONS CLÉS ÉTRANGÈRES
' ============================================

produits }o--o| fournisseurs : "fournisseur_id"
variantes_produits }o--|| produits : "produit_id"
conditionnements_produits }o--|| produits : "produit_id"
lots_produits }o--|| produits : "produit_id"
lots_produits }o--o| variantes_produits : "variante_id"
lots_produits }o--o| fournisseurs : "fournisseur_id"
documents }o--o| clients : "client_id"
documents }o--o| utilisateurs : "utilisateur_id"
lignes_documents }o--|| documents : "document_id"
lignes_documents }o--o| produits : "produit_id"
lignes_documents }o--o| variantes_produits : "variante_id"
reçus_paiements }o--|| clients : "client_id"
reçus_paiements }o--o| utilisateurs : "utilisateur_id"
historique_crédit }o--|| clients : "client_id"
historique_crédit }o--o| documents : "document_id"
historique_crédit }o--o| reçus_paiements : "reçu_paiement_id"
jetons_rafraîchissement }o--|| utilisateurs : "utilisateur_id"
jetons_accès }o--|| utilisateurs : "utilisateur_id"
jetons_réinitialisation }o--|| utilisateurs : "utilisateur_id"

' ============================================
' NOTES
' ============================================

note right of produits
  - référence indexée pour scan POS rapide (< 500ms)
  - Supporte quantités décimales pour POIDS, LONGUEUR, VOLUME
  - image stockée comme chaîne base64
  - prix_unitaire: prix de vente par défaut
end note

note right of variantes_produits
  - Variantes multi-SKU avec attributs JSON flexibles
  - Supporte calibre, matériau, couleur, etc.
  - sku: identifiant unique de l'unité de stockage
end note

note right of lots_produits
  - Suivi inventaire FIFO par lot
  - Coût_unitaire (achat) et prix_unitaire (vente)
  - variante_id optionnel pour lots par variante
  - Indexes composites pour allocation FIFO efficace
end note

note right of documents
  - Héritage SINGLE_TABLE: DEVIS, BON_LIVRAISON, FACTURE
  - est_livraison: contrôle l'application des frais de transport
  - frais_transport: nullable, défini uniquement si est_livraison = VRAI
  - droit_timbre par défaut: 1.000 DT (FACTURE)
  - taux_tva par défaut: 19.00%
end note

note right of historique_crédit
  - Table d'audit IMMUTABLE
  - Suppression douce uniquement (drapeau supprimé)
  - montant: Positif pour augmentation dette, Négatif pour paiements
end note

@enduml
